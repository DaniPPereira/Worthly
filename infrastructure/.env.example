# Copy to .env (never commit .env). Values below are names/placeholders only.

WORTHLY_BOOTSTRAP_EMAIL=owner@localhost
WORTHLY_BOOTSTRAP_PASSWORD_FILE=./secrets/examples/bootstrap-password.txt
WORTHLY_WEB_CLIENT_SECRET_FILE=./secrets/examples/web-client-secret.txt
WORTHLY_SESSION_SECRET_FILE=./secrets/examples/session-secret.txt
WORTHLY_POSTGRES_PASSWORD_FILE=./secrets/examples/postgres-password.txt
WORTHLY_DATASOURCE_PASSWORD=change-me
WORTHLY_OAUTH_SIGNING_KEY_FILE=/path/to/oauth-signing-key.pem
WORTHLY_ISSUER=http://localhost:8080
WORTHLY_WEB_ORIGIN=http://localhost:3000
WORTHLY_WEB_REDIRECT_URI=http://localhost:3000/auth/callback
WORTHLY_WEB_CLIENT_ID=worthly-web
WORTHLY_API_URL=http://localhost:8080
WORTHLY_ENABLE_BANKING_APPLICATION_ID=
# Host path to a PKCS#8 PEM. Compose mounts it into the API as /run/secrets/enable_banking_key.
# Do not commit the PEM. Use: infrastructure/secrets/enable-banking.pem
WORTHLY_ENABLE_BANKING_PRIVATE_KEY_FILE=./secrets/enable-banking.pem
WORTHLY_ENABLE_BANKING_CALLBACK_URL=http://localhost:8080/api/v1/connections/enable-banking/callback
WORTHLY_ENABLE_BANKING_WEB_RESULT_URL=http://localhost:3000/connections/result
# 32-byte AES key file for encrypted provider payloads. Do not commit the file.
WORTHLY_DATA_KEY_FILE=/path/to/aes-256-data-key.txt
# Leave empty for public registration. Non-empty would require a matching invite.
WORTHLY_REGISTRATION_INVITE=
# Passphrase file for openssl-encrypted pg_dump backups. Required in production.
WORTHLY_BACKUP_KEY_FILE=/path/to/backup-passphrase.txt
